{
  "name": "",
  "version": "1.0.0",
  "description": "Alkebu-Lan Images backend CMS",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3000",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3000",
    "generate:importmap": "cross-env NODE_OPTIONS=\"--no-deprecation --loader ./css-stub-loader.mjs\" payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=\"--no-deprecation --loader ./css-stub-loader.mjs\" payload generate:types",
    "check:scripts": "tsc --project tsconfig.scripts.json --pretty false",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3000",
    "test": "cross-env NODE_OPTIONS=--no-deprecation STRIPE_SECRET_KEY=sk_test_dummy node --test --import tsx --test-reporter tap \"./tests/**/*.test.ts\"",
    "square:staging-reprocess": "cross-env NODE_OPTIONS=\"--no-deprecation --loader ./css-stub-loader.mjs\" tsx scripts/square-staging-reprocess.ts",
    "square:staging-promote": "cross-env NODE_OPTIONS=\"--no-deprecation --loader ./css-stub-loader.mjs\" tsx scripts/square-staging-promote.ts",
    "authors:merge": "cross-env NODE_OPTIONS=\"--no-deprecation --loader ./css-stub-loader.mjs\" tsx scripts/author-merge.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.952.0",
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/db-sqlite": "^3.91.0",
    "@payloadcms/email-nodemailer": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/plugin-mcp": "3.91.0",
    "@payloadcms/plugin-seo": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "@payloadcms/storage-s3": "^3.91.0",
    "@payloadcms/ui": "^3.91.0",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "cross-env": "^7.0.3",
    "drizzle-orm": "0.45.2",
    "flexsearch": "^0.8.212",
    "graphql": "^16.12.0",
    "libsql": "^0.4.7",
    "next": "^16.4.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.1.7",
    "papaparse": "^5.5.3",
    "parse-full-name": "^1.2.6",
    "payload": "^3.91.0",
    "rate-limiter-flexible": "^7.4.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "sharp": "^0.35.5",
    "square": "^43.2.1",
    "stripe": "^18.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@sanity/client": "^7.13.2",
    "@sanity/image-url": "^1.2.0",
    "@types/node": "^22.19.3",
    "@types/node-fetch": "^2.6.13",
    "@types/papaparse": "^5.5.2",
    "@types/parse-full-name": "^1.2.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "better-sqlite3": "^12.5.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.2",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "5.7.3",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "fast-xml-parser@<5.5.6": "^5.5.6",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "undici@>=7 <7.29.1": "^7.29.1",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4 <4.0.4": "^4.0.4",
      "lodash@<4.18.0": "^4.18.0",
      "immutable@>=4 <4.3.9": "^4.3.9",
      "immutable@>=5 <5.1.5": "^5.1.5",
      "form-data@>=4 <4.0.6": "^4.0.6",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "fast-uri@<3.1.7": "^3.1.7",
      "source-map-js@<1.2.2": "^1.2.2",
      "proxy-addr@<2.0.8": "^2.0.8",
      "@modelcontextprotocol/sdk@<1.31.0": "^1.31.0",
      "hono@<4.13.11": "^4.13.11",
      "@hono/node-server@<1.19.15": "^1.19.15",
      "qs@<6.16.0": "^6.16.0",
      "fast-copy@<3.1.0": "^3.1.0",
      "yaml@<1.10.3": "^1.10.3"
    }
  }
}
