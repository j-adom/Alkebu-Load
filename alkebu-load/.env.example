# Database Configuration
DATABASE_URI=file:./alkebulanimages.db
# Alternative PostgreSQL: DATABASE_URI=postgresql://user:password@localhost:5432/alkebulanimages

# Payload CMS
PAYLOAD_SECRET=your-secret-key-here-32-characters-minimum
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Square POS Integration (Inventory Sync Only)
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_APPLICATION_ID=your-square-application-id
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# External Book APIs
ISBNDB_API_KEY=your-isbndb-api-key
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Email Configuration (Transactional)
FROM_EMAIL=orders@alkebulanimages.com
FROM_NAME=Alkebu-Lan Images
SES_SMTP_USER=your-ses-smtp-user
SES_SMTP_PASSWORD=your-ses-smtp-password
SMTP_HOST=email-smtp.us-east-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Staff Notifications
STAFF_NOTIFICATION_EMAIL=info@alkebulanimages.com
ORDER_ADMIN_BASE_URL=http://localhost:3000

# Tax Configuration
TENNESSEE_STATE_TAX_RATE=0.07
NASHVILLE_LOCAL_TAX_RATE=0.025
DEFAULT_LOCAL_TAX_RATE=0.02

# Shipping Configuration
SHIPPING_ORIGIN_ZIP=37203
SHIPPING_ORIGIN_STATE=TN
FREE_SHIPPING_THRESHOLD=7500

# Security & Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Cloudflare Turnstile (bot protection on /api/contact)
# Server-only secret used to verify tokens against challenges.cloudflare.com.
# Pair with PUBLIC_TURNSTILE_SITE_KEY on the SvelteKit side. Set this in Coolify
# environment variables for production. Get from the Cloudflare dashboard:
# https://dash.cloudflare.com → Turnstile → Sites → (your widget) → Secret key.
TURNSTILE_SECRET_KEY=

# Development
NODE_ENV=development

# Job Runner Configuration
# Set to exactly "true" in production only. Enables Payload's job queue runner,
# which queues and executes the scheduled tasks in payload.config.ts. Square sync
# jobs queued by the webhook also only run when this is on. Never enable it on a
# dev machine.
ENABLE_JOB_AUTORUN=
# Separate opt-in for the customer-emailing jobs (abandoned-cart reminders, quote
# follow-ups). Unset = never queued, even with ENABLE_JOB_AUTORUN=true.
ENABLE_CUSTOMER_EMAIL_JOBS=

# /api/long-tail-search (Ingram "Search all books"). 404s unless 'true'. Leave unset until the
# live Ingram provider ships: the mock returns sample titles.
LONG_TAIL_SEARCH_ENABLED=
LONG_TAIL_HOURLY_CAP=120

# Ingram Content Group (plan: docs/superpowers/plans/2026-07-09-ingram-availability-engine.md).
# Agreement §2(c): Ingram data never goes to an AI/LLM service; owner runs the live scripts.
# SFTP (ftp.ingramcontent.com): the Catalog Stock feed behind the nightly availability refresh.
INGRAM_FTP_HOST=
INGRAM_FTP_USER=
INGRAM_FTP_PASSWORD=
# Defaults to Inventory/Catalog_Stock.
INGRAM_CATALOG_STOCK_DIR=
# Turns on the scheduled ingram-stock-fetch / ingram-stock-apply jobs (also needs ENABLE_JOB_AUTORUN).
# Leave unset until the owner has run `pnpm ingram:stock-refresh -- --apply` once and reviewed it.
INGRAM_STOCK_REFRESH_ENABLED=
# LaVergne on-hand fallback threshold when no availability code is present (default 10).
INGRAM_STOCK_THRESHOLD=
# Web Service (SOAP). Only the smoke test uses it until Ingram enables the Stock Check add-on.
INGRAM_WS_URL=
INGRAM_WS_USER=
INGRAM_WS_PASSWORD=
